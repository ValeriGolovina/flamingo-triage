# Supabase Postgres (project: flamingo-test, eu-west-1 / West EU Ireland)
# Get both from: Supabase dashboard -> Get connected -> ORM -> Prisma

# Pooled connection (pgbouncer, transaction mode, port 6543) — used at runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Direct connection (port 5432) — used by Prisma Migrate only.
# Migrations need a real session; the transaction pooler cannot serve them.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Signs the session cookie. Any long random string; regenerate with:
#   openssl rand -base64 32
SESSION_SECRET=""

# Protects the cron routes (stale-claim sweep, outbox drain)
CRON_SECRET=""

# Phase 2.5 — realtime signal. Leave unset until then; polling carries the app.
NEXT_PUBLIC_REALTIME=""
